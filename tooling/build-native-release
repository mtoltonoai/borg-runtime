#!/usr/bin/env bash
# Build exactly the clean checked-out commit into an immutable, checksummed release.
set -euo pipefail
repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo"
if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
  echo 'Refusing an unattributable release: commit source changes first.' >&2
  exit 1
fi
revision="$(git rev-parse HEAD)"
build_root="${BORG_BUILD_ROOT:-$repo/.runtime/build}"
profile="${BORG_BUILD_PROFILE:-dev}"
case "$profile" in dev) artifact=debug ;; release) artifact=release ;; *) echo 'Use dev or release build profile' >&2; exit 2 ;; esac
output="${1:-$repo/.runtime/releases/$revision}"
mkdir -p "$build_root" "$(dirname "$output")"
build_root="$(cd "$build_root" && pwd)"
if [[ -e "$output" ]]; then
  echo "Release already exists; verify/reuse it or choose a different output path: $output" >&2
  exit 1
fi
# Build caches are disposable and need not consume enormous debug-symbol space.
# These knobs do not affect model/runtime context or execution limits.
export CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 CARGO_INCREMENTAL=0
export BORG_BUILD_REV="$revision" FLEET_BUILD_REV="$revision"
export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-1.99.0}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-8}"
CARGO_TARGET_DIR="$build_root/native" cargo build --locked --profile "$profile" --bin borg-native
(cd components/fleet && CARGO_TARGET_DIR="$build_root/fleet" cargo build --locked --profile "$profile" --bin fleet)
(cd components/task-board && CARGO_TARGET_DIR="$build_root/board" cargo build --locked --profile "$profile" --bin task-board)
(cd components/task-board/web && npm ci --no-audit --no-fund && npm run build)
# Fail if someone edited source or switched revisions during a long build.
[[ "$(git rev-parse HEAD)" == "$revision" ]]
[[ -z "$(git status --porcelain --untracked-files=normal)" ]]
stage="$(mktemp -d "$(dirname "$output")/.release-XXXXXXXX")"
trap 'rm -rf -- "$stage"' EXIT
install -m 755 "$build_root/native/$artifact/borg-native" "$stage/borg-native"
install -m 755 "$build_root/fleet/$artifact/fleet" "$stage/fleet"
install -m 755 "$build_root/board/$artifact/task-board" "$stage/task-board"
for file in workspace_mcp.py native_ready.py native_release.py native_drain.py; do
  install -m 755 "tooling/$file" "$stage/$file"
done
for file in native_recovery.py native_acceptance.py; do
  if [[ -f "tooling/$file" ]]; then install -m 755 "tooling/$file" "$stage/$file"; fi
done
cp -a components/task-board/web/dist "$stage/web"
python3 tooling/native_release.py manifest --release "$stage" --revision "$revision" > /dev/null
python3 tooling/native_release.py verify --release "$stage" > /dev/null
mv -T -- "$stage" "$output"
trap - EXIT
printf 'Release built: %s\nRevision: %s\n' "$output" "$revision"
