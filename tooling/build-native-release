#!/usr/bin/env bash
# Build exactly the selected components of a clean commit; no unrelated rebuilds.
set -euo pipefail
repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo"
if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
  echo 'Refusing an unattributable release: commit source changes first.' >&2; exit 1
fi
revision="$(git rev-parse HEAD)"
components="${BORG_BUILD_COMPONENTS:-native,fleet,board,workspace,session-workspace}"
case ",$components," in *,,*|*[!a-z,-]*) echo 'Invalid component selection' >&2; exit 2 ;; esac
IFS=',' read -ra selected <<< "$components"
for component in "${selected[@]}"; do
  case "$component" in native|fleet|board|workspace|session-workspace|recovery) ;; *) echo "Unknown component: $component" >&2; exit 2 ;; esac
done
has() { [[ ",$components," == *",$1,"* ]]; }
build_root="${BORG_BUILD_ROOT:-$repo/.runtime/build}"
profile="${BORG_BUILD_PROFILE:-dev}"
case "$profile" in dev) artifact=debug ;; release) artifact=release ;; *) echo 'Use dev or release profile' >&2; exit 2 ;; esac
output="${1:-$repo/.runtime/releases/$revision}"
mkdir -p "$build_root" "$(dirname "$output")"
build_root="$(cd "$build_root" && pwd)"
if [[ -e "$output" ]]; then
  echo "Immutable release already exists: $output" >&2; exit 1
fi
export CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 CARGO_INCREMENTAL=0
export BORG_BUILD_REV="$revision" FLEET_BUILD_REV="$revision" TASK_BOARD_COMMIT="$revision"
export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-8}"
if has native; then
  CARGO_TARGET_DIR="$build_root/native" cargo build --locked --profile "$profile" --bin borg-native
fi
if has fleet; then
  (cd components/fleet && CARGO_TARGET_DIR="$build_root/fleet" cargo build --locked --profile "$profile" --bin fleet)
fi
if has board; then
  (cd components/task-board && CARGO_TARGET_DIR="$build_root/board" cargo build --locked --profile "$profile" --bin task-board)
  (cd components/task-board/web && npm ci --no-audit --no-fund && npm run build)
fi
[[ "$(git rev-parse HEAD)" == "$revision" ]]
[[ -z "$(git status --porcelain --untracked-files=normal)" ]]
stage="$(mktemp -d "$(dirname "$output")/.release-XXXXXXXX")"
trap 'rm -rf -- "$stage"' EXIT
has native && install -m 755 "$build_root/native/$artifact/borg-native" "$stage/borg-native"
has fleet && install -m 755 "$build_root/fleet/$artifact/fleet" "$stage/fleet"
if has board; then
  install -m 755 "$build_root/board/$artifact/task-board" "$stage/task-board"
  cp -a components/task-board/web/dist "$stage/web"
fi
if has workspace || has session-workspace; then install -m 755 tooling/workspace_mcp.py "$stage/workspace_mcp.py"; fi
if has recovery; then install -m 755 tooling/native_recovery.py "$stage/native_recovery.py"; fi
for file in native_ready.py native_release.py native_drain.py native_metadata.py native_profile_switch.py; do install -m 755 "tooling/$file" "$stage/$file"; done
if [[ -f tooling/native_acceptance.py ]]; then install -m 755 tooling/native_acceptance.py "$stage/native_acceptance.py"; fi
python3 tooling/native_release.py manifest --release "$stage" --revision "$revision" --components "$components" > /dev/null
python3 tooling/native_release.py verify --release "$stage" > /dev/null
mv -T -- "$stage" "$output"
trap - EXIT
printf 'Release built: %s\nRevision: %s\nComponents: %s\n' "$output" "$revision" "$components"
